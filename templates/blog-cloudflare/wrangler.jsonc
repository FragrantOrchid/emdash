{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-database",
			"database_id": "7cd5357b-c17c-4eb6-98e0-a9820134aff7",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-media",
		},
	],
	// The adapter injects SESSION only when this binding is absent; pinning the
	// existing namespace keeps deploys from provisioning a duplicate.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "538d2689a4d44f03ac75f2a770716898",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
